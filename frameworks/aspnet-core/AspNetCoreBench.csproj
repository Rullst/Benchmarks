<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AspNetCoreBench</RootNamespace>
    <!-- Restore writes packages.lock.json; the image restores with locked mode. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- EF Core is referenced directly so that its latest 10.0 patch (the one
         released with the .NET 10.0.15 runtime) is used instead of the lowest
         version the Npgsql provider accepts. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- POST /login checks users.password_bcrypt: ASP.NET Core Identity's
         PasswordHasher reads only its own PBKDF2 format. -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.1" />
  </ItemGroup>

</Project>
